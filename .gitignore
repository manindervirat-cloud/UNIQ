# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# Python build / distribution artifacts.
# These are ANCHORED with a leading slash on purpose: unanchored patterns match
# at every depth, so a bare `lib/` would also ignore frontend/src/lib/ (the API
# client) and a bare `build/` would ignore any frontend build folder.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js / Next.js
node_modules/
.next/
out/
.DS_Store
*.pem

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS
Thumbs.db
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.coverage
.pytest_cache/
htmlcov/

# Temporary files
*.tmp
*.bak

# Dropbox conflict copies (this project lives in a synced folder)
*conflicted copy*

# Application Automation runtime data — per-user applications DB + audit log.
# Treated as user data, not source. Anchored so it can't accidentally swallow
# any other /storage/data/ path that might be added later.
/src/backend/modules/apply/storage/data/

# SOP version store (repo-root /storage/) — runtime user data.
# The SOP module writes one JSON per (student, university target) here at
# runtime (auto-created on first write; see src/backend/modules/sop/services/
# versions.py). Contains personal student content — never source code.
/storage/

# TypeScript incremental build info (generated by next build / tsc)
*.tsbuildinfo
