# ============================================================
# Study Abroad AI Platform - Environment Configuration
# ============================================================
# Copy this file to .env and customize for your environment
# All values shown are defaults or examples

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_NAME="Study Abroad AI Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="development"  # development, staging, production

# ============================================================
# BACKEND API (FastAPI)
# ============================================================
API_HOST="0.0.0.0"
API_PORT=8000
API_RELOAD=true  # Auto-reload on code changes (development only)
API_WORKERS=1    # Number of worker processes (production: 4+)

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"  # Comma-separated list

# ============================================================
# FRONTEND (Next.js)
# ============================================================
NEXT_PUBLIC_API_URL="http://localhost:8000"  # Backend API URL (used by the frontend at runtime)
API_ORIGIN="http://localhost:8000"             # Optional explicit override for Next.js API rewrites (defaults to NEXT_PUBLIC_API_URL)

# ============================================================
# AI & LLM CONFIGURATION
# ============================================================
# IMPORTANT: This application does NOT currently use AI/LLM APIs
# It uses deterministic algorithms for university ranking
#
# If you plan to add AI features in the future:
# - Uncomment and configure the relevant sections below
# - Add corresponding dependencies to requirements.txt

# --- OpenAI (if adding GPT features) ---
# NOTE: The embedded SOP module reads OPENAI_API_KEY (unprefixed) to enable
# AI-drafted SOPs. When unset, the SOP module degrades gracefully to a
# deterministic template draft (never a 500). See the SOP MODULE section below.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4-turbo-preview"
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=1000

# --- Anthropic Claude (if adding Claude features) ---
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-opus-20240229"
# ANTHROPIC_MAX_TOKENS=1000

# --- Google Gemini (if adding Gemini features) ---
# GOOGLE_API_KEY="..."
# GEMINI_MODEL="gemini-pro"

# --- Local LLM (if using Ollama/LM Studio) ---
# LOCAL_LLM_URL="http://localhost:11434"
# LOCAL_LLM_MODEL="llama2"

# ============================================================
# SOP MODULE (embedded — mounted at /api/v1/sop/*)
# ============================================================
# The SOP generator is vendored at src/backend/modules/sop/ and mounted into
# the host FastAPI app as a single APIRouter. There is NO second service, NO
# second port, NO network hop. All SOP env vars use the SOP_ prefix EXCEPT
# OPENAI_API_KEY (above), which keeps its conventional name.
#
# CRITICAL (embedded mode):
#  - SOP_API_KEY must stay UNSET. The host app has no auth boundary here;
#    setting SOP_API_KEY would force the frontend to send X-API-Key, shipping
#    a secret to the browser. verify_api_key is a no-op when unset.
#  - SOP_CORS_ORIGINS must stay EMPTY. The SOP router owns no CORS middleware;
#    the browser reaches it via the Next.js /api proxy (same-origin), and CORS
#    is handled once, by the host app. Direct browser access is not supported.
#  - Never prefix any SOP value with NEXT_PUBLIC_.

# Optional: enable AI-drafted SOPs (else deterministic template draft)
# OPENAI_API_KEY="sk-..."        # already covered in the AI section above

SOP_ENVIRONMENT="development"    # development, staging, production
SOP_LOG_LEVEL="INFO"             # DEBUG, INFO, WARNING, ERROR, CRITICAL
SOP_LOG_FORMAT="json"            # json, console

# LLM tuning (only relevant when OPENAI_API_KEY is set)
SOP_MODEL="gpt-4o-mini"
SOP_GENERATION_TEMPERATURE=0.7
SOP_REVISION_TEMPERATURE=0.6
SOP_LLM_TIMEOUT_SECONDS=90.0
SOP_LLM_MAX_RETRIES=2

# University research (web crawl via optional deps; degrades to no-research if
# the optional libs are missing). Per-request options.research=false also works.
SOP_RESEARCH_ENABLED=true
SOP_RESEARCH_MAX_PAGES=4
SOP_RESEARCH_PAGE_TIMEOUT_SECONDS=12.0
SOP_RESEARCH_MAX_RESULTS_PER_QUERY=3

# SOP defaults
SOP_DEFAULT_WORD_TARGET=1000     # midpoint of the standard 800-1200 range
SOP_MAX_WORD_TARGET=5000
SOP_MAX_FEEDBACK_LENGTH=2000
SOP_MAX_SOP_TEXT_LENGTH=60000

# MUST stay unset in embedded mode (see CRITICAL note above)
# SOP_API_KEY=
# MUST stay empty in embedded mode (see CRITICAL note above)
# SOP_CORS_ORIGINS=

# ============================================================
# DATABASE
# ============================================================
# IMPORTANT: Currently uses in-memory Python data structures
# No external database required
#
# If migrating to a database:
# DATABASE_URL="postgresql://user:password@localhost:5432/study_abroad"
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# ============================================================
# VECTOR DATABASE (for semantic search)
# ============================================================
# Not currently used
#
# --- Pinecone ---
# PINECONE_API_KEY="..."
# PINECONE_ENVIRONMENT="us-west1-gcp"
# PINECONE_INDEX_NAME="universities"

# --- Qdrant ---
# QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY="..."
# QDRANT_COLLECTION_NAME="universities"

# --- Weaviate ---
# WEAVIATE_URL="http://localhost:8080"
# WEAVIATE_API_KEY="..."

# ============================================================
# EMBEDDING MODEL
# ============================================================
# Not currently used
#
# --- OpenAI Embeddings ---
# EMBEDDING_PROVIDER="openai"
# EMBEDDING_MODEL="text-embedding-3-small"

# --- Sentence Transformers (Local) ---
# EMBEDDING_PROVIDER="sentence-transformers"
# EMBEDDING_MODEL="all-MiniLM-L6-v2"

# ============================================================
# RERANKER
# ============================================================
# Not currently used
#
# --- Cohere Rerank ---
# COHERE_API_KEY="..."
# RERANK_MODEL="rerank-english-v2.0"

# ============================================================
# SEARCH PROVIDER
# ============================================================
# Not currently used (no external search integration)
#
# --- Algolia ---
# ALGOLIA_APP_ID="..."
# ALGOLIA_API_KEY="..."
# ALGOLIA_INDEX_NAME="universities"

# --- Elasticsearch ---
# ELASTICSEARCH_URL="http://localhost:9200"
# ELASTICSEARCH_INDEX="universities"

# ============================================================
# AUTHENTICATION
# ============================================================
# Not currently implemented
#
# --- JWT Settings ---
# JWT_SECRET_KEY="your-secret-key-here-change-in-production"
# JWT_ALGORITHM="HS256"
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- OAuth Providers ---
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
# GITHUB_CLIENT_ID="..."
# GITHUB_CLIENT_SECRET="..."

# ============================================================
# EXTERNAL SERVICES
# ============================================================

# --- Email Service (for notifications) ---
# Not currently used
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# --- Analytics ---
# Not currently used
# GOOGLE_ANALYTICS_ID="G-..."
# MIXPANEL_TOKEN="..."

# --- Error Tracking ---
# SENTRY_DSN="https://...@sentry.io/..."

# --- Rate Limiting ---
# REDIS_URL="redis://localhost:6379/0"

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json, text

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY="change-this-in-production-use-strong-random-value"
ALLOWED_HOSTS="localhost,127.0.0.1"

# ============================================================
# PERFORMANCE
# ============================================================
CACHE_TTL=3600  # Cache time-to-live in seconds
MAX_REQUEST_SIZE=10485760  # 10MB in bytes

# ============================================================
# FEATURES FLAGS
# ============================================================
ENABLE_ANALYTICS=false
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=false

# ============================================================
# DEVELOPMENT TOOLS
# ============================================================
DEBUG=true  # Set to false in production
RELOAD_ON_CHANGE=true  # Auto-reload (development only)
